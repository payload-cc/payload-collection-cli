{
  "name": "@payload-cc/payload-collection-cli",
  "version": "1.4.0",
  "type": "module",
  "description": "Functional CLI for Payload collection management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payload-cc/payload-collection-cli.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "payload-collection-cli": "./dist/bin.js",
    "payload-collection-docs-mcp": "./dist/docs-mcp.js",
    "payload-collection-mcp": "./dist/cli-mcp.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/bin.js dist/docs-mcp.js dist/cli-mcp.js",
    "release": "pnpm build && pnpm publish --access public",
    "test": "vitest run tests/*",
    "test:e2e": "pnpm e2e:prepare && pnpm build && vitest run e2e-tests/scenarios/ --no-file-parallelism --test-timeout 60000",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "e2e:prepare": "node e2e-tests/prepare.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "peerDependencies": {
    "payload": "^3.90.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jiti": "^2.7.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@payloadcms/db-sqlite": "3.90.2",
    "@types/node": "^25.5.0",
    "@types/yargs": "^17.0.35",
    "payload": "^3.90.2",
    "tsup": "^8.5.1",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  }
}
